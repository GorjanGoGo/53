#include <iostream>
#include <vector>
using namespace std;

class DSUSize {
    vector<int> p, sz;
public:
    DSUSize(int n) : p(n), sz(n, 1) {
        for (int i = 0; i < n; i++) p[i] = i;
    }
    int findSet(int x) {
        while (x != p[x]) x = p[x];
        return x;
    }
    void mergeSet(int x, int y) {
        x = findSet(x);
        y = findSet(y);
        if (x == y) return;
        if (sz[x] < sz[y]) {
            p[x] = y;
            sz[y] += sz[x];
        } else {
            p[y] = x;
            sz[x] += sz[y];
        }
    }
};

class DSUHeight {
    vector<int> p, h;
public:
    DSUHeight(int n) : p(n), h(n, 0) {
        for (int i = 0; i < n; i++) p[i] = i;
    }
    int findSet(int x) {
        while (x != p[x]) x = p[x];
        return x;
    }
    void mergeSet(int x, int y) {
        x = findSet(x);
        y = findSet(y);
        if (x == y) return;
        if (h[x] < h[y]) p[x] = y;
        else if (h[x] > h[y]) p[y] = x;
        else {
            p[y] = x;
            h[x]++;
        }
    }
};

class DSURankPC {
    vector<int> p, r;
public:
    DSURankPC(int n) : p(n), r(n, 0) {
        for (int i = 0; i < n; i++) p[i] = i;
    }
    int findSet(int x) {
        return (p[x] == x) ? x : p[x] = findSet(p[x]);
    }
    void mergeSet(int x, int y) {
        x = findSet(x);
        y = findSet(y);
        if (x == y) return;
        if (r[x] < r[y]) p[x] = y;
        else if (r[x] > r[y]) p[y] = x;
        else {
            p[y] = x;
            r[x]++;
        }
    }
};

int main() {
    cout << "Union-Find by Size" << endl;
    DSUSize a(6);
    a.mergeSet(0, 1);
    a.mergeSet(2, 3);
    a.mergeSet(1, 2);
    cout << "0 i 3 se povrzani? " << (a.findSet(0) == a.findSet(3)) << endl;

    cout << "Union-Find by Height" << endl;
    DSUHeight b(6);
    b.mergeSet(0, 1);
    b.mergeSet(2, 3);
    b.mergeSet(3, 4);
    b.mergeSet(1, 4);
    cout << "0 i 4 se povrzani? " << (b.findSet(0) == b.findSet(4)) << endl;

    cout << "Union-Find by Rank + Path Compression" << endl;
    DSURankPC c(6);
    c.mergeSet(0, 1);
    c.mergeSet(1, 2);
    c.mergeSet(3, 4);
    c.mergeSet(2, 4);
    cout << "0 i 4 se povrzani? " << (c.findSet(0) == c.findSet(4));

    return 0;
}
